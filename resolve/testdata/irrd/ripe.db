source:         RIPE

route:          203.0.113.128/25
origin:         AS65003
member-of:      RS-INNER
mnt-by:         MNT-B
source:         RIPE

route6:         2001:db8::/32
origin:         AS65001
mnt-by:         MNT-A
source:         RIPE

route6:         2001:db8:1::/48
origin:         AS65002
mnt-by:         MNT-B
source:         RIPE

filter-set:     FLTR-FOO
filter:         AS65001 OR {192.0.2.0/24^+}
mp-filter:      {2001:db8::/32^+}
admin-c:        JD1-RIPE
tech-c:         JD1-RIPE
mnt-by:         MNT-A
source:         RIPE

peering-set:    PRNG-FOO
peering:        AS65002 at 192.0.2.1
mp-peering:     AS65002 at 2001:db8::1
admin-c:        JD1-RIPE
tech-c:         JD1-RIPE
mnt-by:         MNT-A
source:         RIPE

rtr-set:        RTRS-FOO
members:        rtr1.example.net, 192.0.2.1
admin-c:        JD1-RIPE
tech-c:         JD1-RIPE
mnt-by:         MNT-A
source:         RIPE

